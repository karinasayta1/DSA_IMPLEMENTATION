//leetcode 233
#include <iostream>
#include <vector>
using namespace std;

class Solution {
public:
    
    void solve(int start, int k, int remaining_sum,
               vector<int>& current,
               vector<vector<int>>& result) {
        
        
        if (current.size() == k && remaining_sum == 0) {
            result.push_back(current);
            return;
        }

       
        if (current.size() > k || remaining_sum < 0) {
            return;
        }

        for (int i = start; i <= 9; i++) {
            
            current.push_back(i);  // choose
            
            solve(i + 1, k, remaining_sum - i, current, result); // explore
            
            current.pop_back();    // un-choose (backtrack)
        }
    }

    vector<vector<int>> combinationSum3(int k, int n) {
        vector<int> current;
        vector<vector<int>> result;
        
        solve(1, k, n, current, result);
        
        return result;
    }
};

int main() {
    int k, n;

    cout << "Enter k (how many numbers): ";
    cin >> k;

    cout << "Enter n (target sum): ";
    cin >> n;

    Solution obj;
    vector<vector<int>> answer = obj.combinationSum3(k, n);

    cout << "\nValid Combinations:\n";

    for (int i = 0; i < answer.size(); i++) {
        cout << "[ ";
        for (int j = 0; j < answer[i].size(); j++) {
            cout << answer[i][j] << " ";
        }
        cout << "]\n";
    }

    return 0;
}
